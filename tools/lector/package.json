{
  "name": "lector-document-ocr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/setup-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/setup-assets.mjs",
    "build": "tsc --noEmit && vite build",
