---
import type { Locale } from '../lib/paths';
import { education, certificates } from '../data/education';
import { ui } from '../data/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<ul class="items">
  {education.map((item) => (
    <li class="item">
      <p class="item-period">{item.period}</p>
      <div><h3>{item.school[locale]}</h3><p class="item-summary">{item.detail[locale]}</p></div>
    </li>
  ))}
</ul>
<h3 class="sub-title">{ui.certificates[locale]}</h3>
<ul class="items compact">
  {certificates.map((cert) => (
    <li class="item">
      <p class="item-period">{cert.date}</p>
      <div><p class="cert">{cert.name[locale]}<span> · {cert.issuer[locale]}</span></p></div>
    </li>
  ))}
</ul>
