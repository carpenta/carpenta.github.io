---
import { localePath, type Locale } from '../lib/paths';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
  path: string;
  nav?: { href: string; label: string }[];
}

const { locale, path, nav = [] } = Astro.props;
---
<header class="side">
  <a class="side-name" href={localePath(locale, '/')}><h1>{profile.name[locale]}</h1></a>
  <p class="side-role">{profile.role[locale]}</p>
  <p class="side-tagline">{profile.tagline[locale]}</p>

  {nav.length > 0 && (
    <nav class="side-nav" aria-label={locale === 'ko' ? '섹션' : 'Sections'}>
      <ul>{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
  )}

  <ul class="contact">
    <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    <li><a href={profile.github} rel="me noopener">GitHub</a></li>
  </ul>

  <nav class="lang" aria-label={locale === 'ko' ? '언어' : 'Language'}>
    <a href={localePath('ko', path)} hreflang="ko" aria-current={locale === 'ko' ? 'true' : undefined}>KO</a>
    <span aria-hidden="true">/</span>
    <a href={localePath('en', path)} hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
  </nav>
</header>

<script>
  if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.side-nav a'));
    if (navLinks.length > 0) {
      const sections = navLinks
        .map((link) => {
          const href = link.getAttribute('href');
          return href && href.startsWith('#') ? document.querySelector<HTMLElement>(href) : null;
        })
        .filter((el): el is HTMLElement => el !== null);

      if (sections.length > 0) {
        const updateActive = () => {
          const scrollY = window.scrollY;
          let current: string | null = null;

          if (window.innerHeight + scrollY >= document.documentElement.scrollHeight - 50) {
            current = `#${sections[sections.length - 1].id}`;
          } else {
            for (const section of sections) {
              const top = section.offsetTop - 140;
              const height = section.offsetHeight;
              if (scrollY >= top && scrollY < top + height) {
                current = `#${section.id}`;
                break;
              }
            }
          }

          navLinks.forEach((link) => {
            const isActive = current !== null ? link.getAttribute('href') === current : false;
            link.classList.toggle('active', isActive);
          });
        };

        window.addEventListener('scroll', updateActive, { passive: true });
        updateActive();
      }
    }
  }
</script>
