---
import { altLocale, localePath, type Locale } from '../lib/paths';
import { profile } from '../data/profile';
import { ui } from '../data/ui';

interface Props {
  locale: Locale;
  path: string;
  nav?: { href: string; label: string }[];
}

const { locale, path, nav = [] } = Astro.props;
---
<header class="side">
  <a class="side-name" href={localePath(locale, '/')}><h1>{profile.name[locale]}</h1></a>
  <p class="side-role">{profile.role[locale]}</p>
  <p class="side-tagline">{profile.tagline[locale]}</p>

  {nav.length > 0 && (
    <nav class="side-nav" aria-label={locale === 'ko' ? '섹션' : 'Sections'}>
      <ul>{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
  )}

  <ul class="contact">
    <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    <li><a href={profile.github} rel="me noopener">GitHub</a></li>
  </ul>

  <div class="side-prefs">
    <nav class="lang" aria-label={locale === 'ko' ? '언어' : 'Language'}>
      <a class="icon-btn lang-btn" href={localePath(altLocale(locale), path)} hreflang={altLocale(locale)} lang={altLocale(locale)} aria-label={ui.langSwitchTo[locale]} title={ui.langSwitchTo[locale]}>
        <span class="lang-code" aria-hidden="true">{ui.langSwitchCode[locale]}</span>
      </a>
    </nav>
    <button
      class="icon-btn theme-toggle"
      type="button"
      aria-label={ui.themeToLight[locale]}
      title={ui.themeToLight[locale]}
      data-to-light={ui.themeToLight[locale]}
      data-to-dark={ui.themeToDark[locale]}
    >
      <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
    </button>
  </div>
</header>

<script>
  {
    const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
    if (toggle) {
      const root = document.documentElement;
      const current = () =>
        root.dataset.theme ?? (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      const render = () => {
        const label = (current() === 'light' ? toggle.dataset.toDark : toggle.dataset.toLight) ?? '';
        toggle.setAttribute('aria-label', label);
        toggle.title = label;
      };
      toggle.addEventListener('click', () => {
        const next = current() === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch { /* 저장할 수 없으면 이번 방문에만 적용 */ }
        render();
      });
      render();
    }
  }

  if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.side-nav a'));
    if (navLinks.length > 0) {
      const sections = navLinks
        .map((link) => {
          const href = link.getAttribute('href');
          return href && href.startsWith('#') ? document.querySelector<HTMLElement>(href) : null;
        })
        .filter((el): el is HTMLElement => el !== null);

      if (sections.length > 0) {
        const updateActive = () => {
          const scrollY = window.scrollY;
          let current: string | null = null;

          if (window.innerHeight + scrollY >= document.documentElement.scrollHeight - 50) {
            current = `#${sections[sections.length - 1].id}`;
          } else {
            for (const section of sections) {
              const top = section.offsetTop - 140;
              const height = section.offsetHeight;
              if (scrollY >= top && scrollY < top + height) {
                current = `#${section.id}`;
                break;
              }
            }
          }

          navLinks.forEach((link) => {
            const isActive = current !== null ? link.getAttribute('href') === current : false;
            link.classList.toggle('active', isActive);
          });
        };

        window.addEventListener('scroll', updateActive, { passive: true });
        updateActive();
      }
    }
  }
</script>
