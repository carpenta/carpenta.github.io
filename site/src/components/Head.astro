---
import { altLocale, localePath, type Locale } from '../lib/paths';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
}

const { locale, title, description, path, noindex = false } = Astro.props;
const other = altLocale(locale);
const canonical = new URL(localePath(locale, path), Astro.site).href;
const alternate = new URL(localePath(other, path), Astro.site).href;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
{!noindex && <link rel="alternate" hreflang={locale} href={canonical} />}
{!noindex && <link rel="alternate" hreflang={other} href={alternate} />}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preload" href="/fonts/PretendardVariable.woff2" as="font" type="font/woff2" crossorigin />
